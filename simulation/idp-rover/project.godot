[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="rover"

[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=5
3d/default_gravity=3.7109999999999985
3d/solver/solver_iterations=8

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
shading/overrides/force_lambert_over_burley=true
